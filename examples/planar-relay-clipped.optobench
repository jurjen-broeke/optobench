format = "optobench/1"
kind = "layout"
layout = "planar"

# The planar relay with a tube between L1 and the fold mirror whose 3 mm bore is narrower
# than the collimated beam (about 3.5 mm across): the tube clips the beam.

[[source]]
id = "object"
kind = "point"
wavelength_um = 0.55
power_w = 0.001
half_angle_deg = 1.0
rings = 8
offset = [0.0, 2.0]
at = 0.0

[[element]]
id = "L1"
kind = "lens"
at = 99.3289
surfaces = [ { radius = 100.0 }, { radius = -100.0 } ]
thickness = [4.0]
material = [1.5]
diameter = 25.4
clear_aperture = 22.9

[[element]]
id = "M1"
kind = "mirror"
at = 202.6577
fold = 90.0
diameter = 25.4
clear_aperture = 22.9

[[element]]
id = "L2"
kind = "lens"
at = 301.9866
surfaces = [ { radius = 100.0 }, { radius = -100.0 } ]
thickness = [4.0]
material = [1.5]
diameter = 25.4
clear_aperture = 22.9

[[detector]]
id = "image"
at = 405.3154
size = [10, 10]
pixels = [100, 100]

[[proxy]]
id = "narrow-tube"
kind = "tube"
inner_diameter = 3.0
from = 110.0
to = 190.0
